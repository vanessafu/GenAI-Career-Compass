# Supabase project API URL, for example: https://your-project-ref.supabase.co
# Dashboard project URLs are also accepted and normalized by the scripts.
SUPABASE_URL=

# Server-side only. Use an sb_secret_... key or legacy service_role JWT.
# Never expose this in frontend/client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only. Used by scripts/map_roles_to_esco.py for embeddings.
OPENAI_API_KEY=

# Optional, local data-generation only. Used by scripts/generate_german_salary_seed.py.
# Do not expose these in frontend/client code.
# ENTGELTATLAS_BASE_URL can point at an endpoint root such as:
# https://rest.arbeitsagentur.de/infosysbub/entgeltatlas/pc/v1
ENTGELTATLAS_BASE_URL=
ENTGELTATLAS_X_API_KEY=
ENTGELTATLAS_CLIENT_ID=
ENTGELTATLAS_CLIENT_SECRET=
