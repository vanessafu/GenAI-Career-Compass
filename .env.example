# Copy this file to .env. Replace placeholders locally and never commit .env.
ENVIRONMENT=development

# Required only when running the backend locally.
OPENAI_API_KEY=replace-with-private-openai-key
# Use the read-only career_compass_runtime login described in
# database/supabase/runtime_reader.sql, never an owner/admin connection.
DATABASE_URL=replace-with-read-only-postgres-url

# Optional model overrides.
OPENAI_MODEL=gpt-4o-mini
OPENAI_CV_PARSING_MODEL=gpt-5.5
OPENAI_IDENTITY_MODEL=gpt-5.4-mini
OPENAI_ROLE_DESCRIPTION_MODEL=gpt-5.4-mini
OPENAI_CAREER_PATH_MODEL=gpt-5.4
OPENAI_TEMPERATURE=1

# Optional: only needed by backend/scripts/role_embeddings.py when rebuilding
# catalog descriptions. It is not used by the web application.
GEMINI_API_KEY=replace-with-private-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Optional after the sentence-transformer model has been downloaded once.
# HF_HUB_OFFLINE=1
