# Environment Variables - Sensitive Information Only
# Copy to .env and fill in actual values (Do NOT commit .env to git)

ENVIRONMENT=development

# API Keys
LLM_API_KEY=your-openai-api-key-here
ESCO_API_KEY=your-esco-api-key-here
ONET_API_KEY=your-onet-api-key-here
VECTOR_DB_API_KEY=your-vector-db-key-here

# Connection URLs
DATABASE_URL=postgresql://user:password@localhost/career_compass
REDIS_URL=redis://localhost:6379
