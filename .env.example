# Environment Variables - Sensitive Information Only
# Copy to .env and fill in actual values (Do NOT commit .env to git)

ENVIRONMENT=development

# OpenAI API Configuration
OPENAI_API_KEY=<your_openai_api_key_here>
OPENAI_MODEL=gpt-4o-mini
OPENAI_CV_PARSING_MODEL=gpt-5.5
OPENAI_IDENTITY_MODEL=gpt-5.4-mini
OPENAI_ROLE_DESCRIPTION_MODEL=gpt-5.4-mini
OPENAI_CAREER_PATH_MODEL=gpt-5.4
OPENAI_TEMPERATURE=1

# Gemini API Configuration (role catalog skill ranking, backend/scripts/role_embeddings.py)
GEMINI_API_KEY=<your_gemini_api_key_here>
GEMINI_MODEL=gemini-3.5-flash

# Database Configuration - Supabase PostgreSQL (connection pooler, port 6543)
# Format: postgresql://postgres.[PROJECT-ID]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[PROJECT-ID]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Pipeline artifacts: every step persists its output JSON under this directory
# (parsed CV, privacy-stripped CV, identity statement, embedding-ready profile).
# PIPELINE_OUTPUT_DIR=outputs/pipeline

# Once BAAI/bge-base-en-v1.5 is cached locally (~/.cache/huggingface), set this
# to skip the huggingface.co HEAD-request round trips on every model load.
# Every `uvicorn --reload` restart reloads the embedder singleton from scratch,
# so this meaningfully speeds up dev-server restarts while iterating.
# Leave unset for a fresh checkout so the first run can still download the model.
# HF_HUB_OFFLINE=1
