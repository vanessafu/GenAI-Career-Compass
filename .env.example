# Environment Variables - Sensitive Information Only
# Copy to .env and fill in actual values (Do NOT commit .env to git)

ENVIRONMENT=development

# OpenAI API Configuration
OPENAI_API_KEY=<your_openai_api_key_here>
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0

# Database Configuration
DATABASE_URL=

# Pipeline artifacts: every step persists its output JSON under this directory
# (parsed CV, privacy-stripped CV, identity statement, embedding-ready profile).
# PIPELINE_OUTPUT_DIR=outputs/pipeline